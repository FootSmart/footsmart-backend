# Copier vers .env et remplir les valeurs (ne pas committer .env)

# Serveur
PORT=3001
# Si conflit (EADDRINUSE), change par ex: 3002

# JWT (obligatoire en production — ne pas utiliser la valeur par défaut du code)
JWT_SECRET=
# Durée du token : ex. 3600s, 1h, 7d (doit être identique pour signature et vérification — voir jwt-config.helper.ts)
JWT_EXPIRES_IN=7d

# PostgreSQL / TypeORM — préférer l’URL « Session / Transaction pooler » du dashboard Supabase
# (host aws-*-*.pooler.supabase.com:6543) si db.<ref>.supabase.co donne ENOTFOUND (souvent IPv6 / DNS local).
# Exemple : postgresql://postgres.<PROJECT_REF>:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
SCRAPFOOT_DATABASE_URL=

# true = TypeORM crée/met à jour les tables (dev). false = prod (migrations / SQL manuel)
TYPEORM_SYNC=true

# Crée certaines tables manquantes automatiquement (dev uniquement)
AUTO_CREATE_SCHEMA=true

# Supabase / Postgres (pooler) requiert souvent SSL. true recommandé.
SCRAPFOOT_DATABASE_SSL=true

# Supabase client Scrapfoot (obligatoires)
SCRAPFOOT_SUPABASE_URL=
SCRAPFOOT_SUPABASE_ANON_KEY=

# URL publique du backend (avatarUrl + redirections Stripe Checkout « ajouter une carte »)
# - émulateur Android : http://10.0.2.2:PORT (ex. 3008)
# - téléphone réel sur le même Wi‑Fi : http://IP_LAN_DU_PC:PORT (pas 10.0.2.2)
# - navigateur local : http://localhost:PORT
PUBLIC_BASE_URL=http://localhost:3002

# Email (mot de passe oublié) — EMAIL_PROVIDER par défaut: smtp
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@footsmart.com
APP_NAME=FootSmart Pro
RESET_REDIRECT_URL=myapp://reset-password
# Optionnel : page web de reset
# WEB_RESET_URL=

# Stripe — Dashboard › Développeurs › Clés API (mode test / live)
# Ne jamais committer de vraies clés ; copier depuis Stripe dans ton .env local uniquement.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook : signing secret (stripe listen … ou endpoint Dashboard)
# Événements requis au minimum : payment_intent.succeeded, setup_intent.succeeded
STRIPE_WEBHOOK_SECRET=

# API Python ML (dossier python/ — FastAPI sur le port 8000 par défaut)
# NestJS appelle cette URL pour GET /analytics/predictions
ML_API_URL=http://localhost:8000
